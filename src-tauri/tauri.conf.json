{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitStudio Pro",
  "version": "0.1.0",
  "identifier": "dev.gitstudiopro.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "GitStudio Pro", "width": 1440, "height": 960, "minWidth": 1000, "minHeight": 680, "backgroundColor": "#303446" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'" }
  },
  "bundle": { "active": true, "targets": "all", "shortDescription": "A considered workspace for Git", "category": "DeveloperTool", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "macOS": { "minimumSystemVersion": "11.0" } }
}
